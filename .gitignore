.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env*
!.env.template
claude.md

# Data stays local. Only the public transcripts (data/raw) and vocab (data/vocab)
# are versioned. Scotland transcripts are UK Data Archive licensed: never commit them.
data/*
!data/raw/
!data/vocab/
!data/CHECKSUMS.sha256
data/raw/scotland/

# Annotation files and samples quote transcript text (incl. Scotland)
code/validation/sampled_speeches.json
code/validation/annotations_csv/
code/**/*.csv

# Outputs
outputs/
results/
code/correlation_analysis/results*/
corpus_statistics/

# Model checkpoints and pickled data
*.pth
*.pt
*.ckpt
*.safetensors
*.pkl
*.npy
